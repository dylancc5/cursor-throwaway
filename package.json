{
  "name": "cursor-throwaway",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @cursor-burner/shared && npm run build -w @cursor-burner/api",
    "build:web": "npm run build -w @cursor-burner/shared && npm run build -w @cursor-burner/web",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev -w @cursor-burner/api",
    "dev:web": "npm run dev -w @cursor-burner/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
